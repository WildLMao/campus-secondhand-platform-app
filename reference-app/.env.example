# 复制为 .env 后填写；不要把填写后的 .env 提交到仓库。
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# 交付环境保持 false；仅本地容器演示可改为 true。
DEMO_SEED=false
# 必填：初始管理员账号与密码（至少 12 位、同时包含字母和数字，UTF-8 不超过 72 字节）。
# 密码留空时 compose 与后端都会拒绝启动，避免形成无管理员空库。
BOOTSTRAP_ADMIN_USERNAME=ops_admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NICKNAME=校园管理员
# 经 HTTPS 反向代理交付时改为 true。
SESSION_COOKIE_SECURE=false
